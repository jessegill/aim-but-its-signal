# Dependencies
node_modules/

# Build output
dist/
out/
build/
*.tsbuildinfo

# Electron packaging
release/
*.dmg
*.zip
*.app

# Local account state — NEVER commit. A linked device has full account access.
# signal-cli's real on-disk layout is data/<e164>, data/<e164>.d/, data/accounts.json,
# so the whole directory is ignored outright — --config can point anywhere, and a
# narrower pattern is trivially defeated.
/data/
.signal-cli/
signal-cli-data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlitedb
*.db3

# Message content downloaded by the daemon — real media from real contacts.
/attachments/
/avatars/
/stickers/

# Key material. Signing certs in particular land in the repo root by habit.
*.pem
*.key
*.p12
*.pfx
*.p8
*.jks
*.keystore
*.asc
*.gpg
*.mobileprovision
id_rsa
id_ed25519
.netrc

# Test coverage
coverage/

# Envelope captures — contain real message bodies, phone numbers and UUIDs.
*.jsonl
/captures/

# Secrets / local config
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Logs
*.log
npm-debug.log*
